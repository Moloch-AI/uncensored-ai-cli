# Copy to .env (never commit it) or export these in your shell. The CLI reads environment
# variables; it does not load .env files by itself. `molochai config set-key` is the other way
# to store the key (in the config file, see the README).

MOLOCHAI_API_KEY=your-api-key

# Optional (defaults shown)
# MOLOCHAI_BASE_URL=https://api.molochai.dev/api/v1
# MOLOCHAI_MODEL=glm-5.3-flash
# MOLOCHAI_CONFIG_DIR=      # directory that holds config.json; default depends on the platform
# MOLOCHAI_TIMEOUT=120      # seconds; read by the SDK
# MOLOCHAI_MAX_RETRIES=2    # read by the SDK

# Offline, against the mock server from uncensored-ai-api:
# MOLOCHAI_BASE_URL=http://127.0.0.1:4010/api/v1
# MOLOCHAI_API_KEY=mock-key
